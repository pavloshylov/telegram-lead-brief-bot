# Token from @BotFather
BOT_TOKEN=123456:replace-me

# Comma-separated Telegram user IDs with access to the admin panel (get yours from @userinfobot)
ADMIN_IDS=111111111

# SQLite by default; for PostgreSQL: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

COMPANY_NAME=Northwind Studio
TIMEZONE=Europe/Kyiv

# Bot language: en / uk = everyone gets that language; auto = each user's Telegram language (Ukrainian or English)
BOT_LANGUAGE=en

# Demo only: lets a manager open their own brief link to try both roles with one account
ALLOW_SELF_BRIEF=false

# Broadcast speed, messages per second (Telegram allows ~30)
BROADCAST_RATE=20

# Payments (optional, off by default). Paid step after the brief: "Reserve a paid session".
# Card payments: provider token from @BotFather > your bot > Payments (a TEST token for a test provider).
PAYMENTS_PROVIDER_TOKEN=
# Telegram Stars (currency XTR, no provider needed): on / off
PAYMENTS_STARS=off
# Currency for card payments (ISO 4217, 2 decimals)
PAYMENTS_CURRENCY=USD

# Run against Telegram's separate test environment (test accounts and bots from @BotFather on the test server).
# Use a separate env file for it: ENV_FILE=.env.testserver python -m app
TELEGRAM_TEST_ENV=false
