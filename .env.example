# Token from @BotFather
BOT_TOKEN=123456:replace-me

# Comma-separated Telegram user IDs with access to the admin panel (get yours from @userinfobot)
ADMIN_IDS=111111111

# SQLite by default; for PostgreSQL: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

COMPANY_NAME=Northwind Studio
TIMEZONE=Europe/Kyiv

# Demo only: lets a manager open their own brief link to try both roles with one account
ALLOW_SELF_BRIEF=false

# Broadcast speed, messages per second (Telegram allows ~30)
BROADCAST_RATE=20
